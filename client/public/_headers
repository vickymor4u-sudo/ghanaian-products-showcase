# Only applies to requests Cloudflare serves as native static assets —
# i.e. the paths client/public/_routes.json excludes from Pages
# Functions (/assets/*, /images/*, /robots.txt, /sitemap.xml). HTML page
# routes still go through functions/_middleware.ts and are deliberately
# left alone here, so canonical/robots injection keeps controlling their
# response and they keep revalidating on every deploy.
#
# Cloudflare Pages does not set a long-lived Cache-Control by default —
# confirmed empirically (docs/PERFORMANCE_AUDIT.md, Fix 2 verification):
# excluding a path from Functions routing alone still returned
# `max-age=0, must-revalidate`. This file is the actual mechanism.

# Vite content-hashes these filenames (a new build always gets a new
# name), so it's safe to cache them forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Image filenames are stable, not content-hashed — if a file is ever
# replaced in place under the same name, a long-but-finite max-age lets
# it pick up eventually rather than caching a stale image forever.
/images/*
  Cache-Control: public, max-age=604800

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
